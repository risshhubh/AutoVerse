{
    "version": 2,
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "devCommand": "npm run dev",
    "installCommand": "npm install --legacy-peer-deps",
    "env": {
        "NODE_OPTIONS": "--max-old-space-size=6144",
        "UV_THREADPOOL_SIZE": "1"
    }
}